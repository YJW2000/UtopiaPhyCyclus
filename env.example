# AI service configuration.
# Copy this file to `.env` and fill in your own API key.

AI_API_KEY=your_api_key_here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL_NAME=qwen3.8-max

# Optional: LLM HTTP request timeouts (seconds), used by the diagram correction agent.
# AI_READ_TIMEOUT     how long to wait for the model to finish responding (default 240).
# AI_CONNECT_TIMEOUT  how long to wait for the TCP/TLS connection (default 10).
# Slow local AI gateways (e.g. Antigravity Tools on 127.0.0.1:8045) may need a larger
# AI_READ_TIMEOUT (e.g. 300); values are clamped to 30..900 and 3..60. Restart the app
# after changing them. If a timeout still occurs, the agent shows an actionable Chinese
# error and (when reference images were attached) retries once with text only.
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=240

# Optional: use a separate model for solution generation.
# If unset, the app falls back to qwen3.6-flash in the current code.
AI_SOLVER_MODEL_NAME=qwen3.6-flash

# Optional: embedding model for hybrid/semantic question search.
# DashScope compatible example; clear this value to keep using exact search only.
AI_EMBEDDING_MODEL_NAME=text-embedding-v4

# Optional: maximum seconds allowed for a TikZ/XeLaTeX preview compile.
# The default is 60 to accommodate first-run font-cache initialization.
TIKZ_COMPILE_TIMEOUT=60

# Optional fallback OCR prompt. If `ocr_prompt.txt` exists, it takes precedence.
# Use `\n` for line breaks when defining a multi-line prompt in .env.
AI_OCR_PROMPT=请识别这张图片中的高中物理题，并严格按照 LaTeX 格式输出。

# ---------------------------------------------------------------------------
# Optional: 物理插图矫正 AGENT 上下文/会话优化（均有默认值，不配置即可）
# 单轮上下文体积实测：无历史约 6.8KB、2 轮对话约 9.2KB；以下变量可进一步调优。
# ---------------------------------------------------------------------------
# 回放历史条数上限（0=不回放；默认 4，clamp 0..8）
# PI_AGENT_HISTORY_MESSAGES=4
# 回放历史总字符预算（默认 4000，clamp 1000..20000；超出时丢弃更旧消息，至少保留最新 1 条）
# PI_AGENT_HISTORY_MAX_CHARS=4000
# 注入提示词的技能数（默认 2，clamp 1..3；技能流水线 pre/post 仍最多用 3 个）
# PI_AGENT_SKILL_PROMPT_MAX=2
# 浏览器会话中最多保留多少道题的 Agent 对话（默认 8，clamp 1..50；超出淘汰最久未访问）
# PI_AGENT_HISTORY_KEEP_QUESTIONS=8
# 视觉复核开关（1=启用，0=关闭以加速；默认 1）
# PI_AGENT_VISUAL_CHECK=1

